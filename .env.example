# Copy to .env and fill in. NEVER commit the real .env.

# --- Core -------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# development | production | testing
APP_ENV=development

# Public origin, used for canonical URLs, sitemap, RSS and JSON-LD.
SITE_URL=https://amirhosseinnk.ir

# Set to 1 ONLY for local debugging. Never in production.
FLASK_DEBUG=0

# --- Database ---------------------------------------------------------
# Defaults to SQLite at data/resume.db when unset.
#
# WARNING: on a container host (Liara, Railway, Render...) the app
# directory is wiped on every deploy, so a SQLite file there loses every
# project, article and contact message. Either mount a persistent disk
# and point this at a file on it, or use a managed Postgres.
#
# A provider's postgres:// URL can be pasted verbatim; it is rewritten to
# postgresql+psycopg:// automatically.
#   postgres://user:pass@host:5432/dbname
#   sqlite:////var/lib/resume/resume.db
DATABASE_URL=

# --- Admin ------------------------------------------------------------
ADMIN_USERNAME=
# Generate with: python scripts/generate_password_hash.py
ADMIN_PASSWORD_HASH=

# --- Mail -------------------------------------------------------------
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=
# Gmail requires an App Password, not your account password.
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
CONTACT_RECIPIENT_EMAIL=

# --- Rate limiting ----------------------------------------------------
# In-memory is per-process. With more than one worker use Redis:
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0
RATELIMIT_STORAGE_URI=memory://
